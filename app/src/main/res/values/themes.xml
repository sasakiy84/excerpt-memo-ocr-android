<resources>
    <style name="Theme.ExcerptMemo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/excerpt_primary</item>
        <item name="colorOnPrimary">@color/excerpt_on_primary</item>
        <item name="colorPrimaryContainer">@color/excerpt_selected</item>
        <item name="colorOnPrimaryContainer">@color/excerpt_ink</item>
        <item name="colorSecondary">@color/excerpt_muted</item>
        <item name="colorSecondaryContainer">@color/excerpt_selected</item>
        <item name="colorOnSecondaryContainer">@color/excerpt_ink</item>
        <item name="colorSurface">@color/excerpt_background</item>
        <item name="colorOnSurface">@color/excerpt_ink</item>
        <item name="colorOnSurfaceVariant">@color/excerpt_muted</item>
        <item name="colorSurfaceContainer">@color/excerpt_panel</item>
        <item name="colorOutline">@color/excerpt_outline</item>
        <item name="colorOutlineVariant">@color/excerpt_outline</item>
        <item name="android:colorBackground">@color/excerpt_background</item>
        <item name="android:windowBackground">@color/excerpt_background</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="TextAppearance.Excerpt.Toolbar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/excerpt_ink</item>
    </style>
    <style name="Widget.Excerpt.ModeButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/mode_button_text</item>
        <item name="backgroundTint">@color/mode_button_background</item>
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">10dp</item>
    </style>
    <style name="Widget.Excerpt.SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/excerpt_outline</item>
    </style>
    <style name="Widget.Excerpt.Filter" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/excerpt_muted</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>
</resources>
