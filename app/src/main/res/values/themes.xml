<resources>
    <bool name="light_system_bars">true</bool>
    <style name="Theme.ExcerptMemo" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/excerpt_primary</item>
        <item name="android:colorControlNormal">@color/excerpt_muted</item>
        <item name="android:colorControlActivated">@color/excerpt_primary</item>
        <item name="android:colorBackground">@color/excerpt_background</item>
        <item name="android:windowBackground">@color/excerpt_background</item>
        <item name="android:textColorPrimary">@color/excerpt_ink</item>
        <item name="android:textColorSecondary">@color/excerpt_muted</item>
        <item name="android:buttonStyle">@style/Widget.Excerpt.Button</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="TextAppearance.Excerpt.Toolbar" parent="android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/excerpt_ink</item>
    </style>
    <style name="Widget.Excerpt.Button" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/excerpt_on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item><item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">16dp</item>
    </style>
    <style name="Widget.Excerpt.SecondaryButton" parent="Widget.Excerpt.Button">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/excerpt_ink</item>
    </style>
    <style name="Widget.Excerpt.ModeButton" parent="android:style/Widget.Material.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/button_mode</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/mode_button_text</item>
        <item name="android:minWidth">48dp</item><item name="android:minHeight">48dp</item>
    </style>
</resources>
