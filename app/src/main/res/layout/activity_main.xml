<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/excerpt_background" android:orientation="vertical" android:focusableInTouchMode="true">
    <Toolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:paddingHorizontal="4dp" android:title="@string/app_name" android:titleTextAppearance="@style/TextAppearance.Excerpt.Toolbar" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/camera_panel" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="vertical">
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:layout_marginHorizontal="12dp" android:layout_marginTop="4dp"
                android:background="@drawable/page_canvas_background" android:clipToOutline="true">
                <com.sasakiy84.excerptmemo.CameraPreview android:id="@+id/preview"
                    android:layout_width="match_parent" android:layout_height="match_parent" />
                <Button android:id="@+id/permission_button"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:text="@string/camera_permission" android:visibility="gone" />
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="104dp"
                android:gravity="center" android:orientation="horizontal">
                <ImageButton android:id="@+id/import_button"
                    style="@style/Widget.Excerpt.SecondaryButton" android:layout_width="56dp" android:layout_height="56dp"
                    android:contentDescription="@string/import_image"
                    android:padding="16dp" android:src="@drawable/ic_image" android:tint="@color/excerpt_ink" android:scaleType="centerInside" />
                <Space android:layout_width="24dp" android:layout_height="1dp" />
                <ImageButton android:id="@+id/shutter"
                    android:layout_width="76dp" android:layout_height="76dp" android:minWidth="0dp" android:minHeight="0dp"
                    android:padding="22dp"

                    android:contentDescription="@string/capture" android:background="@drawable/button_shutter" android:src="@drawable/ic_camera" android:tint="@color/excerpt_on_primary" android:scaleType="centerInside" />
                <Space android:layout_width="24dp" android:layout_height="1dp" />
                <Space android:layout_width="56dp" android:layout_height="1dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/document_panel" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">

            <LinearLayout android:id="@+id/document_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
                <com.sasakiy84.excerptmemo.PageView android:id="@+id/page_view"
                    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:layout_marginHorizontal="12dp" android:background="@drawable/page_canvas_background"
                    android:clipToOutline="true" android:contentDescription="@string/page_description" />
                <com.sasakiy84.excerptmemo.TextDrawer android:id="@+id/text_drawer"
                    android:layout_width="match_parent" android:layout_height="148dp" android:orientation="vertical"
                    android:layout_marginHorizontal="12dp" android:layout_marginTop="8dp"
                    android:background="@drawable/excerpt_text_background" android:visibility="gone">
                    <FrameLayout android:id="@+id/drawer_handle" android:layout_width="match_parent" android:layout_height="48dp"
                        android:focusable="true" android:contentDescription="@string/text_drawer_height">
                        <View android:layout_width="40dp" android:layout_height="4dp" android:layout_gravity="center" android:background="@drawable/drawer_handle" />
                    </FrameLayout>
                    <EditText android:id="@+id/result_text" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                        android:gravity="top|start" android:paddingHorizontal="14dp" android:paddingBottom="14dp" android:paddingTop="8dp"
                        android:background="@android:color/transparent" android:textColor="@color/excerpt_ink"
                        android:textColorHint="@color/excerpt_muted" android:lineSpacingExtra="4dp"
                        android:inputType="textMultiLine|textCapSentences" android:textSize="14sp"
                        android:scrollbars="vertical" android:importantForAutofill="no" android:hint="@string/result_text" />
                </com.sasakiy84.excerptmemo.TextDrawer>
            </LinearLayout>
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingHorizontal="20dp" android:paddingTop="10dp" android:textSize="13sp"
                android:textColor="@color/excerpt_muted" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:id="@+id/progress"
                android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true"
                android:layout_marginHorizontal="20dp" android:layout_marginTop="8dp" android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingHorizontal="12dp" android:paddingTop="4dp" android:paddingBottom="8dp">
            <RadioGroup android:id="@+id/mode_toggle"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:padding="0dp"
                android:background="@drawable/mode_switch_background"
                android:orientation="horizontal" android:checkedButton="@id/page_mode">
                <RadioButton android:id="@+id/page_mode"
                    style="@style/Widget.Excerpt.ModeButton" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="match_parent" android:text="@string/page" />
                <RadioButton android:id="@+id/text_mode"
                    style="@style/Widget.Excerpt.ModeButton" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="match_parent" android:text="@string/text" />
            </RadioGroup>
                <ImageButton android:id="@+id/read_button" style="@style/Widget.Excerpt.SecondaryButton"
                    android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp"
                    android:padding="12dp" android:scaleType="centerInside" android:src="@drawable/ic_refresh"
                    android:tint="@color/excerpt_ink" android:contentDescription="@string/reread" android:tooltipText="@string/reread" />
                <ImageButton android:id="@+id/copy_button" android:layout_width="48dp" android:layout_height="48dp"
                    android:layout_marginStart="6dp" android:background="@drawable/button_primary" android:padding="12dp"
                    android:scaleType="centerInside" android:src="@drawable/ic_copy" android:tint="@color/excerpt_on_primary"
                    android:contentDescription="@string/copy" android:tooltipText="@string/copy" android:enabled="false" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
