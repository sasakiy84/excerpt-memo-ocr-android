<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/excerpt_background" android:orientation="vertical" android:focusableInTouchMode="true">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:paddingHorizontal="4dp" app:title="@string/app_name" app:titleTextAppearance="@style/TextAppearance.Excerpt.Toolbar" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/camera_panel" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="vertical">
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:layout_marginHorizontal="12dp" android:layout_marginTop="4dp"
                android:background="@drawable/page_canvas_background" android:clipToOutline="true">
                <androidx.camera.view.PreviewView android:id="@+id/preview"
                    android:layout_width="match_parent" android:layout_height="match_parent" />
                <com.google.android.material.button.MaterialButton android:id="@+id/permission_button"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:text="@string/camera_permission" android:visibility="gone" />
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="104dp"
                android:gravity="center" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/import_button"
                    style="@style/Widget.Excerpt.SecondaryButton" android:layout_width="56dp" android:layout_height="56dp"
                    android:contentDescription="@string/import_image" app:icon="@drawable/ic_image" app:iconGravity="textStart"
                    app:iconPadding="0dp" app:iconSize="24dp" android:padding="16dp" />
                <Space android:layout_width="24dp" android:layout_height="1dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/shutter"
                    android:layout_width="76dp" android:layout_height="76dp" android:minWidth="0dp" android:minHeight="0dp"
                    android:insetTop="0dp" android:insetBottom="0dp" android:padding="22dp" app:cornerRadius="38dp"
                    app:icon="@drawable/ic_camera" app:iconSize="32dp" app:iconPadding="0dp" app:iconGravity="textStart"
                    android:contentDescription="@string/capture" />
                <Space android:layout_width="24dp" android:layout_height="1dp" />
                <Space android:layout_width="56dp" android:layout_height="1dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/document_panel" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/mode_toggle"
                android:layout_width="240dp" android:layout_height="56dp" android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp" android:layout_marginBottom="12dp" android:padding="4dp"
                android:background="@drawable/mode_switch_background"
                app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/page_mode">
                <com.google.android.material.button.MaterialButton android:id="@+id/page_mode"
                    style="@style/Widget.Excerpt.ModeButton" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="match_parent" android:text="@string/page" />
                <com.google.android.material.button.MaterialButton android:id="@+id/text_mode"
                    style="@style/Widget.Excerpt.ModeButton" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="match_parent" android:text="@string/text" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <com.sasakiy84.excerptmemo.PageView android:id="@+id/page_view"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:layout_marginHorizontal="12dp" android:layout_marginBottom="4dp"
                android:background="@drawable/page_canvas_background" android:clipToOutline="true"
                android:contentDescription="@string/page_description" />
            <EditText android:id="@+id/result_text" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp" android:gravity="top|start"
                android:minHeight="56dp" android:maxLines="2" android:padding="14dp"
                android:background="@drawable/excerpt_text_background" android:textColor="@color/excerpt_ink"
                android:textColorHint="@color/excerpt_muted" android:lineSpacingExtra="4dp"
                android:inputType="textMultiLine|textCapSentences" android:textSize="17sp"
                android:scrollbars="vertical" android:importantForAutofill="no" android:hint="@string/result_text"
                android:visibility="gone" />
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingHorizontal="20dp" android:paddingTop="10dp" android:textSize="13sp"
                android:textColor="@color/excerpt_muted" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress"
                android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true"
                android:layout_marginHorizontal="20dp" android:layout_marginTop="8dp" android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingHorizontal="16dp" android:paddingTop="4dp" android:paddingBottom="12dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/read_button"
                    style="@style/Widget.Excerpt.SecondaryButton" android:layout_width="wrap_content" android:layout_height="48dp"
                    android:paddingHorizontal="14dp" android:text="@string/read" android:textSize="14sp"
                    app:icon="@drawable/ic_refresh" app:iconSize="18dp" app:iconPadding="6dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/copy_button"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                    android:layout_marginStart="12dp" android:insetTop="0dp" android:insetBottom="0dp"
                    app:cornerRadius="14dp" app:icon="@drawable/ic_copy" app:iconSize="20dp" app:iconGravity="textStart"
                    android:text="@string/copy" android:enabled="false" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
